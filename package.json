{
  "name": "scripture-studio",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["frontend", "server"],
  "scripts": {
    "dev": "concurrently \"npm:dev --workspace frontend\" \"npm:dev --workspace server\"",
    "dev:client": "npm run dev --workspace frontend",
    "dev:server": "npm run dev --workspace server",
    "build": "npm run build --workspace frontend && npm run build --workspace server",
    "db:seed": "npm run seed --workspace server",
    "db:migrate": "npm run migrate --workspace server"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
